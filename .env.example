# SMTP Credentials (NEVER commit real values)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@campus.camp
SMTP_PASS=YOUR_SMTP_PASSWORD_HERE
SMTP_STARTTLS=false

# Sender
MAIL_FROM=info@campus.camp
MAIL_FROM_NAME=CAMPUS

# Alternative SMTP (port 587 with STARTTLS)
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_STARTTLS=true

# Application
NODE_ENV=development
DRY_RUN=true
LOG_LEVEL=info

# Rate Limiting
BATCH_SIZE=10
EMAILS_PER_MINUTE=5
EMAILS_PER_HOUR=100
DAILY_CAP=500

# Warm-up (emails per day by period)
WARMUP_DAY_1_3=20
WARMUP_DAY_4_7=40
WARMUP_DAY_8_14=75
WARMUP_DAY_15_PLUS=150

# Database
DB_PATH=./data/campus-mail.db

# Campus Integration
CAMPUS_URL=https://campus.camp
UNSUBSCRIBE_BASE_URL=https://campus.camp/unsubscribe
PRIVACY_URL=https://campus.camp/privacy
